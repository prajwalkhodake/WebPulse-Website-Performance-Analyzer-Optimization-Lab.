# WebPulse Environment Configuration Template
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5001
SECRET_KEY=change-this-in-production-to-a-secure-random-key-32chars
# Database Connection (Choose SQLite or MySQL)
# SQLite (default):
# DATABASE_URL=sqlite:///webpulse.sqlite3
# MySQL:
# DATABASE_URL=mysql+pymysql://webpulse_user:YourStrongPassword123!@localhost:3306/webpulse_db?charset=utf8mb4

STORAGE_DIR=storage
MAX_CONTENT_LENGTH=52428800
